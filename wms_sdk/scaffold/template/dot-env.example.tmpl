# Copy to .env (never committed) for `podman run --env-file .env`.
# Inside a container, a SQL Server on this machine is host.containers.internal, not 127.0.0.1.
WMS_DATABASE_URL=mssql+pyodbc://user:password@host.containers.internal,1433/wms?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
