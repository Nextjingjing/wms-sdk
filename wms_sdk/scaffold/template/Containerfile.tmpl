# {{package}}: Microsoft ODBC Driver 18, the SDK copy and the migrations.
#
#   podman build -t {{package}} .
#   podman run --rm --env-file .env {{package}}          # alembic upgrade head

FROM python:3.12-slim-bookworm

RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl \
 && curl -fsSLo /tmp/microsoft.deb https://packages.microsoft.com/config/debian/12/packages-microsoft-prod.deb \
 && dpkg -i /tmp/microsoft.deb \
 && rm /tmp/microsoft.deb \
 && apt-get update \
 && ACCEPT_EULA=Y apt-get install -y --no-install-recommends msodbcsql18 \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY alembic.ini .
COPY migrations/ migrations/
COPY wms_sdk/ wms_sdk/
COPY {{package}}/ {{package}}/

CMD ["alembic", "upgrade", "head"]
